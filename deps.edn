{;; ffi/write took (p t offset v) before jolt 0.8.0 and (p t v offset) after,
 ;; and the two cannot be told apart at runtime — so an older jolt must
 ;; refuse, not guess (see docs/guide/dependencies.md). glitter-uikit and
 ;; http-client declare the same floor.
 :jolt/min-version "0.8.0"
 :paths ["src"]

 ;; demo.core/demo.registry only ever needed glitter.core/glitter.alias, both
 ;; of which now live in glitter-core (natives-free — no :jolt/native GTK4/
 ;; GLib declaration anywhere in its deps.edn, unlike the full glitter
 ;; package this used to pin). glitter-uikit@49effd6 now pins glitter-core/
 ;; nexus-jolt itself (no more :local/root on its side either), so this can
 ;; go back to a normal pin too.
 :deps {io.github.jlt-commons/glitter-core
        {:git/url "https://github.com/jlt-commons/glitter-core"
         :git/sha "4fba1ddb069be798adc1ef0c028e6e21a21ec9f3"}
        io.github.jlt-commons/glitter-uikit
        {:git/url "https://github.com/jlt-commons/glitter-uikit"
         :git/sha "b7de95227b67d74d9af83fd70d7a0e3272ce403e"}
        ;; NOT transitive under jolt (org.clojure/clojure is terminal) — see
        ;; docs/guide/dependencies.md.
        org.clojure/spec.alpha {:mvn/version "0.5.238"}
        ;; clj-http-lite over jolt host shims (BSD sockets + OpenSSL via jolt.ffi
        ;; — no JVM); the Live Currency example fetches ECB rates with it.
        ;; v0.0.11: 177b1ce (v0.0.6) had a `recur` across a `try` in net.clj's
        ;; connect walk — jolt refuses that as of 0.8.2, so the old pin no
        ;; longer builds. Fixed upstream; this pin is past that fix.
        jolt-lang/http-client
        {:git/url "https://github.com/jolt-lang/http-client"
         :git/sha "2fb8a981972b67631150e81765de58d822a99e54"}
        ;; Pure-Clojure JSON, and the host API it needs under jolt: data.json's
        ;; date writers use java.time.format.DateTimeFormatter, which RFC 0008
        ;; moves out of jolt core into jolt-lang/time — jolt's load error says
        ;; exactly this, by name, when the dep is missing.
        org.clojure/data.json {:mvn/version "2.5.1"}
        ;; 33c5e98 (v0.0.8) is the commit that actually declares :jolt/provides
        ;; (RFC 0014) for these classes. The old pin predates it, so jolt sees
        ;; the dependency but not what it provides and refuses to load
        ;; DateTimeFormatter with the same "no dependency provides" error as
        ;; if jolt-lang/time weren't declared at all.
        io.github.jolt-lang/time
        {:git/url "https://github.com/jolt-lang/time"
         :git/sha "33c5e9831c046cfcbe68bc0c9c33e92568eaebb1"}}

 :aliases {:demo {:main-opts ["-m" "demo.core"]}}

 :tasks {demo   "jolt -M:demo"
         ;; LaunchServices refuses script executables; jolt build AOT-compiles
         ;; the app into a self-contained Mach-O that IS the bundle executable
         ;; (see docs/guide/bundling.md).
         bundle "mkdir -p Demo.app/Contents/MacOS && jolt build -m demo.core -o Demo.app/Contents/MacOS/demo && rm -rf Demo.app/Contents/MacOS/demo.build"
         app    "open Demo.app"
         diagram "dot -Tsvg dataflow.dot -o docs/demos/dataflow.svg"
         ;; GitHub won't inline-play a .mov, so the gallery embeds a GIF.
         ;; Palette-based single pass keeps the colors clean. Images live
         ;; under docs/demos/ (not media/) so the docs-engine's asset-dirs
         ;; allowlist picks them up too.
         media  "ffmpeg -y -i docs/demos/live-fx.mov -vf 'fps=12,scale=720:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse' docs/demos/live-fx.gif"}}
